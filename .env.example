# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Anthropic (Oracle / pipeline LLM calls) ---
ANTHROPIC_API_KEY=

# --- Neon Postgres (the live data layer) ---
# Full connection string from the Neon dashboard.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- Dimensions.ai (literature ingestion) ---
DIMENSIONS_API_KEY=

# --- Papers browser (dev module, flag `papers_browser`) ---
# A real, monitored contact email Unpaywall requires to resolve free open-access PDF links.
# Optional: unset => the PDF button just opens the publisher page ("unavailable").
UNPAYWALL_EMAIL=

# --- Pipeline toggles ---
USE_LAYER_C=1
USE_LAYER_E=1

# --- Server ---
PORT=8000
MODEL=claude-sonnet-4-5

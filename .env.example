# Last updated: 2026-10-29 10:49 UTC · Full-Stack · empty public PostHog configuration and distinct private dashboard token placeholders.
# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Anthropic (Oracle / pipeline LLM calls) ---
ANTHROPIC_API_KEY=

# --- Neon Postgres (the live data layer) ---
# Full connection string from the Neon dashboard.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- Dimensions.ai (literature ingestion) ---
DIMENSIONS_API_KEY=

# --- Papers browser (dev module, flag `papers_browser`) ---
# A real, monitored contact email Unpaywall requires to resolve free open-access PDF links.
# Optional: unset => the PDF button just opens the publisher page ("unavailable").
UNPAYWALL_EMAIL=

# --- Pipeline toggles ---
USE_LAYER_C=1
USE_LAYER_E=1

# --- Server ---
PORT=8000
MODEL=claude-sonnet-4-5

# --- Opt-in user testing (Release Center flag: user_testing) ---
# Public project identifier; the browser receives this only in research config.
CLARITY_PROJECT_ID=z4upnrbddu
# Set false/0/off/no to disable capture immediately; withdrawal stays available.
# Otherwise the Release Center flag and configured research database control it.
USER_RESEARCH_ENABLED=
# Optional project-admin Data Export JWT for the manual server-side import only.
# Never expose it to browser code, public API responses or version control.
CLARITY_EXPORT_TOKEN=

# --- Optional PostHog product analytics (public project token, never personal API key) ---
# Both values must come from your own project's settings. No account/key is assumed.
POSTHOG_PROJECT_TOKEN=
# Exactly https://us.i.posthog.com or https://eu.i.posthog.com
POSTHOG_API_HOST=
# Optional admin dashboard links; official https://us.posthog.com or eu.posthog.com only.
POSTHOG_PROJECT_URL=
POSTHOG_DASHBOARD_URL=

# --- Private first-party research dashboard ---
# A separate random token of at least 32 characters. Never reuse SITE_PASSWORD.
# Set privately in Render; enter only in the dashboard's memory-only access field.
# Empty on hosted servers denies research-data reads even with the site password.
RESEARCH_ADMIN_TOKEN=

# Isolated research logging (never replace scientific DATABASE_URL).
RESEARCH_DATABASE_URL=
RESEARCH_DATABASE_REQUIRED=false
# Development service only: restricted SELECT-only production research connection.
RESEARCH_PRODUCTION_DATABASE_URL=

# Owner-directed demo activation; false restores optional testing.
RESEARCH_DEMO_MODE=true

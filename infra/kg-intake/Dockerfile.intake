# Last updated: 2026-11-21 23:55 UTC · Claude (Opus 5.5) · KG intake image (build context = repo root)
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pipeline/grobid/batch_worker.py pipeline/grobid/claims.py pipeline/grobid/ingestion_control.py /app/pipeline/grobid/
COPY pipeline/grobid/mcp/core.py /app/pipeline/grobid/mcp/core.py
COPY infra/kg-intake/intake_server.py infra/kg-intake/upload.html infra/kg-intake/entrypoint-intake.sh /app/intake/
RUN chmod +x /app/intake/entrypoint-intake.sh && mkdir -p /data
ENV INTAKE_DATA=/data PIPELINE_DIR=/app/pipeline/grobid PYTHONUNBUFFERED=1
HEALTHCHECK --interval=30s --timeout=5s CMD curl -fs http://localhost:${PORT:-10000}/health || exit 1
ENTRYPOINT ["/app/intake/entrypoint-intake.sh"]

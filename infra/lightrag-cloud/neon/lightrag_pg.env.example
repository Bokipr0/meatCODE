# Last updated: 2026-11-21 21:34 UTC · Claude (Sonnet 5.5) · Phase-4 PG backend env template
# Phase 4 ONLY (after the disk-backed sandbox is verified). Start from an EMPTY workspace and re-ingest;
# LightRAG cannot convert existing file stores. Set these on a NEW Render service, not the baseline one.
LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_VECTOR_STORAGE=PGVectorStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=PGTableGraphStorage
POSTGRES_HOST=<kg-lightrag branch endpoint>
POSTGRES_PORT=5432
POSTGRES_USER=lightrag_kg
POSTGRES_PASSWORD=<secret>
POSTGRES_DATABASE=<db>
POSTGRES_SSL_MODE=require
POSTGRES_WORKSPACE=meatcode_kg

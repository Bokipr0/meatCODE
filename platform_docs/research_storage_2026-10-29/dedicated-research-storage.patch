@@ -0,0 +1,37 @@
+# Last updated: 2026-10-29 · Codex · independent storage routing and wrong-target protection.
+import sys,unittest
+from pathlib import Path
+from unittest.mock import patch
+ROOT=Path(__file__).resolve().parents[1];sys.path[:0]=[str(ROOT/'server'),str(ROOT/'pipeline/user_research')]
+import user_research,research_dashboard
+from settings import research_database_url
+from copy_storage import targets
+
+class StorageIsolationTests(unittest.TestCase):
+    def test_strict_cutover_never_falls_back_to_scientific_database(self):
+        for env in ({'RESEARCH_DATABASE_URL':'research','DATABASE_URL':'science'},
+                    {'RESEARCH_DATABASE_URL':'research','DATABASE_URL':'science','RESEARCH_DATABASE_REQUIRED':'true'},
+                    {'DATABASE_URL':'science','RESEARCH_DATABASE_REQUIRED':'true'},
+                    {'DATABASE_URL':'science'}):
+            expected='research' if env.get('RESEARCH_DATABASE_URL') else None if env.get('RESEARCH_DATABASE_REQUIRED') else 'science'
+            self.assertEqual(user_research.storage_url(env),expected)
+            self.assertEqual(research_database_url(env),expected)
+
+    def test_local_dashboard_uses_research_targets_not_scientific_targets(self):
+        def selected(env,original):return {'DATABASE_URL':'science-'+env,'RESEARCH_DATABASE_URL':'research-'+env}
+        with patch.object(research_dashboard,'_local_settings',side_effect=selected):
+            target,_=research_dashboard._database_settings('dev','prod',{},'science',True)
+        self.assertEqual(target,'research-dev')
+
+    def test_copy_rejects_missing_target_and_same_database_even_different_role_or_pooler(self):
+        source='postgresql://source:fixture@ep-fixture.eu.neon.tech/science?sslmode=require'
+        for target in (None,source,'postgresql://other:fixture@ep-fixture-pooler.eu.neon.tech/science'):
+            with self.assertRaises(ValueError):targets({'DATABASE_URL':source,'RESEARCH_DATABASE_URL':target})
+        target='postgresql://research:fixture@ep-logs.eu.neon.tech/research_prod'
+        self.assertEqual(targets({'DATABASE_URL':source,'RESEARCH_DATABASE_URL':target}),(source,target))
+
+    def test_hosted_dashboard_uses_only_server_selected_connection(self):
+        with self.assertRaises(user_research.InputError):research_dashboard._database_settings('dev','prod',{'RENDER':'true'},'research-prod',False)
+        self.assertEqual(research_dashboard._database_settings('prod','prod',{'RENDER':'true'},'research-prod',False)[0],'research-prod')
+
+if __name__=='__main__':unittest.main()
